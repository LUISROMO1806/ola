<?xml version="1.0" encoding="utf-8"?>
<!-- Va dentro de Api-PlataformaEscolar/Uploads/. Solo afecta a esta carpeta.
     Permite que el visor del chat lea los archivos (PDF, DOCX, XLSX) con fetch desde el front. -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
